class Solution:
    def peopleAwareOfSecret(self, n: int, delay: int, forget: int) -> int:
        MOD = 10**9 + 7

        # dp[i] will store the number of *new* people who learn the secret on day i.
        # We use n+1 for 1-based indexing to match the days.
        dp = [0] * (n + 1)
        
        # On day 1, one person discovers the secret.
        dp[1] = 1
        
        # This variable tracks the number of people who are currently able to share the secret.
        sharing_count = 0
        
        # Iterate from day 2 to day n to fill the dp array.
        for i in range(2, n + 1):
            # --- Update the pool of people who can share today ---
            
            # 1. Add people who start sharing today.
            # A person who learned the secret `delay` days ago (on day i - delay)
            # will start sharing today.
            if i - delay >= 1:
                sharing_count = (sharing_count + dp[i - delay]) % MOD
            
            # 2. Remove people who forget the secret today.
            # A person who learned the secret `forget` days ago (on day i - forget)
            # will forget the secret today and can no longer share.
            if i - forget >= 1:
                sharing_count = (sharing_count - dp[i - forget] + MOD) % MOD
            
            # The number of new people who learn the secret today is equal to the
            # number of people currently sharing.
            dp[i] = sharing_count
            
        # --- Calculate the final answer ---
        
        # The total number of people who know the secret on day `n` are those who
        # learned it on a day `j` such that they have not forgotten it yet.
        # A person who learned on day `j` forgets on day `j + forget`.
        # So, we need to sum up everyone who learned between day `n - forget + 1` and `n`.
        total_aware = 0
        for i in range(n - forget + 1, n + 1):
            total_aware = (total_aware + dp[i]) % MOD
            
        return total_aware
        
