class Solution:
    def sortVowels(self, s: str) -> str:
        vowels_set = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}
        vowels_in_s = []
        for char in s:
            if char in vowels_set:
                vowels_in_s.append(char)

        vowels_in_s.sort()
        result_list = list(s)
        vowel_pointer = 0

        for i in range(len(result_list)):
            if result_list[i] in vowels_set:
                result_list[i] = vowels_in_s[vowel_pointer]
                vowel_pointer += 1

        return "".join(result_list)
