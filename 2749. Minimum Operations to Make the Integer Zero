class Solution:
    def makeTheIntegerZero(self, num1: int, num2: int) -> int:
# We can iterate through possible values of `k` and check these two conditions.
        for k in range(1, 65):  # A loop up to 64 is sufficient given the constraints.
            target = num1 - k * num2

            # The target must be positive, as it's a sum of positive powers of 2.
            # If target ever becomes negative, we can stop, as it will only get smaller
            # if num2 is positive.
            if target < 0:
                break
            
            # `bin(number).count('1')` is a simple way to get the popcount.
            popcount = bin(target).count('1')

            if popcount <= k and target >= k:
                # We found the smallest `k` that satisfies the conditions.
                return k
        
        # If the loop completes without finding a suitable k, it's impossible.
        return -1
