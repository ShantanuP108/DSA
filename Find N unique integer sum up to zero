class Solution:
    def sumZero(self, n: int) -> List[int]:
        result = []
        
        # Iterate from 1 up to n // 2. For each number i, we add both
        # i and its negative counterpart -i. This ensures the sum remains 0.
        for i in range(1, n // 2 + 1):
            result.append(i)
            result.append(-i)
            
        # If n is odd, the loop above will have added n-1 elements.
        # We need one more unique integer, which must be 0 to keep the sum at 0.
        if n % 2 != 0:
            result.append(0)
            
        return result
